{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode & JSX support */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx", // <-- САМЕ ЦЕЙ РЯДОК ЛІКУЄ JSX!

    /* Path Aliases */
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Types */
    "types": ["vite/client"]
  },
  "include": ["src"]
}
